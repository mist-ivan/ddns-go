# ?????ocker build -f Dockerfile.email -t ddns-go-email:6.17.7-email.1 .
FROM golang:1.25-alpine AS builder

WORKDIR /src

# ?????????????????????????????
COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG VERSION=6.17.7-email.3
RUN CGO_ENABLED=0 go build -trimpath \
      -ldflags "-s -w -X main.version=${VERSION}" \
      -o /out/ddns-go .

FROM alpine:3.21

# tzdata ????????url/grep ???????????RUN apk add --no-cache ca-certificates tzdata curl grep

WORKDIR /app
COPY --from=builder /out/ddns-go /app/ddns-go

ENV TZ=Asia/Shanghai
EXPOSE 9876

# ???????????? /root/.ddns_go_config.yaml?????/root ????????VOLUME ["/root"]

ENTRYPOINT ["/app/ddns-go"]
CMD ["-l", ":9876", "-f", "600"]
