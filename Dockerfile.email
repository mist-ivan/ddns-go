# fork 版镜像：在官方 ddns-go 基础上加入 IP 变更邮件提醒
# 构建（务必先提交，再用提交号作为 revision，便于追溯）：
#   REV=$(git rev-parse --short HEAD)
#   docker build -f Dockerfile.email \
#     --build-arg REVISION=$REV \
#     -t ddns-go-email:6.17.7-email-0.16 .
FROM golang:1.25-alpine AS builder

WORKDIR /src

# 依赖单独一层，改代码时不必重新下载模块
COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG VERSION=6.17.7-email-0.16
RUN CGO_ENABLED=0 go build -trimpath \
      -ldflags "-s -w -buildid= -X main.version=${VERSION}" \
      -o /out/ddns-go .

# Alpine 3.21 于 2026-11-01 EOL，这里改用当前受支持的版本
FROM alpine:3.24

ARG VERSION=6.17.7-email-0.16
ARG REVISION=unknown

# 注意：故意不设置 org.opencontainers.image.source。
# 该字段的约定是"源码仓库地址"，而本 fork 的源码没有公开托管（以 git bundle 离线分发），
# 指向一个空仓库会误导使用者。项目信息统一用 url 指向镜像页面。
LABEL org.opencontainers.image.title="ddns-go-email" \
      org.opencontainers.image.description="ddns-go fork: send an email when the public IP changes" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.url="https://hub.docker.com/r/ivanzzffii/ddns-go-email" \
      org.opencontainers.image.base.name="docker.io/library/alpine:3.24" \
      org.opencontainers.image.licenses="MIT"

# 只保留运行时真正需要的 CA 根证书和时区数据。
# 健康检查用 BusyBox 自带的 wget，不再安装 curl/grep，镜像更小。
RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app
COPY --from=builder /out/ddns-go /app/ddns-go

ENV TZ=Asia/Shanghai
EXPOSE 9876

# 配置文件默认位于 /root/.ddns_go_config.yaml，挂载 /root 即可持久化
VOLUME ["/root"]

# 登录页免认证，返回 200 即视为健康；BusyBox wget 已包含在 Alpine 基础镜像中。
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:9876/login || exit 1

ENTRYPOINT ["/app/ddns-go"]
CMD ["-l", ":9876", "-f", "600"]
