# fork 版镜像：在官方 ddns-go 基础上加入 IP 变更邮件提醒
# 构建（务必先提交，再用提交号作为 revision，便于追溯）：
#   REV=$(git rev-parse --short HEAD)
#   docker build -f Dockerfile.email \
#     --build-arg REVISION=$REV \
#     -t ddns-go-email:6.17.7-email-0.7 .
FROM golang:1.25-alpine AS builder

WORKDIR /src

# 依赖单独一层，改代码时不必重新下载模块
COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG VERSION=6.17.7-email-0.7
RUN CGO_ENABLED=0 go build -trimpath \
      -ldflags "-s -w -X main.version=${VERSION}" \
      -o /out/ddns-go .

# Alpine 3.21 于 2026-11-01 EOL，这里改用当前受支持的版本
FROM alpine:3.24

ARG VERSION=6.17.7-email-0.7
ARG REVISION=unknown

LABEL org.opencontainers.image.title="ddns-go-email" \
      org.opencontainers.image.description="ddns-go fork: send an email when the public IP changes" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.source="https://github.com/mist-ivan/ddns-go-email" \
      org.opencontainers.image.licenses="MIT"

# tzdata 提供时区，curl/grep 方便容器内排查
RUN apk add --no-cache ca-certificates tzdata curl grep

WORKDIR /app
COPY --from=builder /out/ddns-go /app/ddns-go

ENV TZ=Asia/Shanghai
EXPOSE 9876

# 配置文件默认位于 /root/.ddns_go_config.yaml，挂载 /root 即可持久化
VOLUME ["/root"]

ENTRYPOINT ["/app/ddns-go"]
CMD ["-l", ":9876", "-f", "600"]
